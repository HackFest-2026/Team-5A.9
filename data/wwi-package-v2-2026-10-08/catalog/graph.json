  "relationships": [
    {
      "from": "customer",
      "to": "order",
      "join": "Orders.CustomerID",
      "cardinality": "1:n",
      "meaning": "orders placed by the customer"
    },
    {
      "from": "order",
      "to": "order_line",
      "join": "OrderLines.OrderID",
      "cardinality": "1:n",
      "meaning": "lines of the order"
    },
    {
      "from": "order_line",
      "to": "stock_item",
      "join": "OrderLines.StockItemID",
      "cardinality": "n:1",
      "meaning": "item ordered"
    },
    {
      "from": "order",
      "to": "salesperson",
      "join": "Orders.SalespersonPersonID",
      "cardinality": "n:1",
      "meaning": "salesperson on the order"
    },
    {
      "from": "order",
      "to": "order",
      "join": "Orders.BackorderOrderID",
      "cardinality": "1:0..1",
      "meaning": "original order -> new backorder created for its undersupplied quantity"
    },
    {
      "from": "order",
      "to": "invoice",
      "join": "Invoices.OrderID",
      "cardinality": "1:0..1",
      "meaning": "observed one invoice per order in this extract"
    },
    {
      "from": "stock_item",
      "to": "supplier",
      "join": "StockItems.SupplierID",
      "cardinality": "n:1",
      "meaning": "nominated supplier of the item"
    },
    {
      "from": "stock_item",
      "to": "stock_group",
      "join": "StockItemStockGroups",
      "cardinality": "n:m",
      "meaning": "product groups (overlapping)"
    },
    {
      "from": "stock_item",
      "to": "holdings",
      "join": "StockItemHoldings.StockItemID",
      "cardinality": "1:1",
      "meaning": "stored stock on hand and reorder level"
    },
    {
      "from": "stock_item",
      "to": "purchase_line",
      "join": "PurchaseOrderLines.StockItemID",
      "cardinality": "1:n",
      "meaning": "related purchasing for the item; NOT allocated to sales orders"
    },
    {
      "from": "purchase_order",
      "to": "purchase_line",
      "join": "PurchaseOrderLines.PurchaseOrderID",
      "cardinality": "1:n",
      "meaning": "lines of the purchase order"
    },
    {
      "from": "purchase_order",
      "to": "supplier",
      "join": "PurchaseOrders.SupplierID",
      "cardinality": "n:1",
      "meaning": "actual supplier of the purchase order"
    },
    {
      "from": "customer",
      "to": "customer_category",
      "join": "Customers.CustomerCategoryID",
      "cardinality": "n:1",
      "meaning": "current category"
    },
    {
      "from": "customer",
      "to": "buying_group",
      "join": "Customers.BuyingGroupID",
      "cardinality": "n:0..1",
      "meaning": "current buying group"
    },
    {
      "from": "customer",
      "to": "state_province",
      "join": "Customers.DeliveryCityID -> Cities.StateProvinceID",
      "cardinality": "n:1",
      "meaning": "current delivery state"
    },
    {
      "from": "state_province",
      "to": "sales_territory",
      "join": "StateProvinces.SalesTerritory",
      "cardinality": "n:1",
      "meaning": "territory of the state"
    },
    {
      "from": "customer",
      "to": "customer",
      "join": "Customers.BillToCustomerID",
      "cardinality": "n:1",
      "meaning": "bill-to account (head office)"
    }
  ],
  "traps": [
    "Purchasing is never allocated to customer orders: relate by item only.",
    "Item supplier (nominated) can differ from purchase order supplier (actual).",
    "Purchase quantities are in outers (e.g. cartons): multiply by QuantityPerOuter for units.",
    "Order counts by item/supplier/stock group overlap.",
    "Customer attributes are current, not as at order time."
  ]
}