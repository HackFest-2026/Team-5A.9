{
  "dataset_version": "wwi-data-v1-2026-10-08",
  "scenario_id": "base",
  "rules": [
    "Carry period, filters and selected entities between steps unless the user replaces them.",
    "Resolve names before filtering; ask when resolve returns ambiguous.",
    "Stop and report when a step returns completed=false; never continue with stale numbers.",
    "Every figure in the answer must come from a step output or code arithmetic over step outputs."
  ],
  "items": [
    {
      "id": "explain_change",
      "question_pattern": "Why did <measure> go up/down between two periods?",
      "answer_style": "Descriptive: where the change is concentrated; never claim a cause.",
      "steps": [
        {
          "step": 1,
          "operation": "analyze",
          "request": {
            "measure_id": "{measure}",
            "start": "{current_start}",
            "end": "{current_end}",
            "compare_start": "{baseline_start}",
            "compare_end": "{baseline_end}"
          },
          "use_output": "total_baseline, total_current, change, pct_change"
        },
        {
          "step": 2,
          "operation": "analyze",
          "request": {
            "measure_id": "{measure}",
            "start": "{current_start}",
            "end": "{current_end}",
            "compare_start": "{baseline_start}",
            "compare_end": "{baseline_end}",
            "group_by": "sales_territory"
          },
          "use_output": "largest share_of_change row -> {top_group}; repeat with customer_category and salesperson to see which dimension concentrates the change"
        },
        {
          "step": 3,
          "operation": "analyze",
          "request": {
            "measure_id": "{measure}",
            "start": "{current_start}",
            "end": "{current_end}",
            "compare_start": "{baseline_start}",
            "compare_end": "{baseline_end}",
            "group_by": "customer",
            "filters": {
              "sales_territory": "{top_group}"
            }
          },
          "use_output": "top contributing customers inside the group"
        },
        {
          "step": 4,
          "operation": "related",
          "request": {
            "entity_type": "customer",
            "entity_id": "{top_customer}"
          },
          "use_output": "context for the top customer"
        },
        {
          "step": 5,
          "operation": "navigate",
          "request": {
            "deep_link": "from step 2 or 3"
          },
          "use_output": "show the evidence page"
        }
      ]
    },
    {
      "id": "unpicked_triage",
      "question_pattern": "Which items hold up fulfilment and is supply coming?",
      "answer_style": "Compare demand, stock and incoming in the same unit (item units).",
      "steps": [
        {
          "step": 1,
          "operation": "analyze",
          "request": {
            "measure_id": "M02",
            "group_by": "stock_item",
            "top_n": 5,
            "start": "{period_start}",
            "end": "{period_end}"
          },
          "use_output": "top item -> {item}"
        },
        {
          "step": 2,
          "operation": "related",
          "request": {
            "entity_type": "stock_item",
            "entity_id": "{item}"
          },
          "use_output": "holdings, unpicked_demand (all dates), incoming lines (outers x QuantityPerOuter)"
        },
        {
          "step": 3,
          "operation": "related",
          "request": {
            "entity_type": "supplier",
            "entity_id": "{item_supplier}"
          },
          "use_output": "supplier context"
        },
        {
          "step": 4,
          "operation": "navigate",
          "request": {
            "deep_link": "#/item/{item}"
          },
          "use_output": "show item evidence"
        }
      ]
    },
    {
      "id": "supplier_exposure",
      "question_pattern": "How exposed are we to supplier <name>?",
      "answer_style": "Demand on its items vs incoming from it; related by item, not allocated.",
      "steps": [
        {
          "step": 1,
          "operation": "resolve",
          "request": {
            "text": "{supplier_name}",
            "types": [
              "supplier"
            ]
          },
          "use_output": "unique -> {supplier}; ambiguous -> ask"
        },
        {
          "step": 2,
          "operation": "related",
          "request": {
            "entity_type": "supplier",
            "entity_id": "{supplier}"
          },
          "use_output": "summary"
        },
        {
          "step": 3,
          "operation": "analyze",
          "request": {
            "measure_id": "M02",
            "group_by": "stock_item",
            "filters": {
              "supplier_id": "{supplier}"
            }
          },
          "use_output": "demand by item"
        },
        {
          "step": 4,
          "operation": "analyze",
          "request": {
            "measure_id": "M05",
            "group_by": "stock_item",
            "filters": {
              "supplier_id": "{supplier}"
            }
          },
          "use_output": "incoming by item"
        }
      ]
    },
    {
      "id": "customer_review",
      "question_pattern": "How is customer <name> doing?",
      "answer_style": "Orders trend, unpicked items, invoiced sales with caveat.",
      "steps": [
        {
          "step": 1,
          "operation": "resolve",
          "request": {
            "text": "{customer_name}",
            "types": [
              "customer",
              "buying_group"
            ]
          },
          "use_output": "unique -> {customer}; ambiguous (e.g. a buying group name) -> ask which"
        },
        {
          "step": 2,
          "operation": "related",
          "request": {
            "entity_type": "customer",
            "entity_id": "{customer}"
          },
          "use_output": "summary"
        },
        {
          "step": 3,
          "operation": "analyze",
          "request": {
            "measure_id": "M01",
            "group_by": "month",
            "start": "2016-01-01",
            "end": "2016-06-01",
            "filters": {
              "customer_id": "{customer}"
            }
          },
          "use_output": "trend"
        },
        {
          "step": 4,
          "operation": "analyze",
          "request": {
            "measure_id": "M02",
            "group_by": "stock_item",
            "filters": {
              "customer_id": "{customer}"
            }
          },
          "use_output": "what they wait for"
        }
      ]
    },
    {
      "id": "segment_comparison",
      "question_pattern": "Compare <segment A> with <segment B> on <measure>.",
      "answer_style": "Same measure, unit, period and filters on both sides.",
      "steps": [
        {
          "step": 1,
          "operation": "analyze",
          "request": {
            "measure_id": "{measure}",
            "group_by": "{dimension}",
            "start": "{period_start}",
            "end": "{period_end}",
            "top_n": 50
          },
          "use_output": "read both rows; state shares"
        },
        {
          "step": 2,
          "operation": "analyze",
          "request": {
            "measure_id": "{measure}",
            "group_by": "month",
            "start": "{period_start}",
            "end": "{period_end}",
            "filters": {
              "{dimension_filter}": "{segment_a}"
            }
          },
          "use_output": "trend for A; repeat for B"
        }
      ]
    },
    {
      "id": "order_trace",
      "question_pattern": "What happened to order <id>?",
      "answer_style": "Lines, picking, backorder chain, invoice.",
      "steps": [
        {
          "step": 1,
          "operation": "related",
          "request": {
            "entity_type": "order",
            "entity_id": "{order}"
          },
          "use_output": "lines, BackorderOrderID, backorder_of, invoices"
        },
        {
          "step": 2,
          "operation": "related",
          "request": {
            "entity_type": "order",
            "entity_id": "{BackorderOrderID}"
          },
          "use_output": "follow the backorder if present"
        },
        {
          "step": 3,
          "operation": "related",
          "request": {
            "entity_type": "stock_item",
            "entity_id": "{unpicked_item}"
          },
          "use_output": "supply for the unpicked item"
        }
      ]
    },
    {
      "id": "money_summary",
      "question_pattern": "What were sales and profit?",
      "answer_style": "Always state: excludes tax, invoice date basis, currency not stated, gross line profit not net.",
      "steps": [
        {
          "step": 1,
          "operation": "analyze",
          "request": {
            "measure_id": "M10",
            "group_by": "month",
            "start": "{period_start}",
            "end": "{period_end}"
          },
          "use_output": "sales trend"
        },
        {
          "step": 2,
          "operation": "analyze",
          "request": {
            "measure_id": "M11",
            "group_by": "month",
            "start": "{period_start}",
            "end": "{period_end}"
          },
          "use_output": "profit trend"
        },
        {
          "step": 3,
          "operation": "analyze",
          "request": {
            "measure_id": "M10",
            "group_by": "customer_category",
            "start": "{period_start}",
            "end": "{period_end}"
          },
          "use_output": "mix"
        }
      ]
    },
    {
      "id": "no_supply_branch",
      "question_pattern": "Which demand has no incoming supply? (synthetic fixture)",
      "answer_style": "Label SYNTHETIC; no reason for missing supply exists.",
      "steps": [
        {
          "step": 1,
          "operation": "related",
          "request": {
            "entity_type": "stock_item",
            "entity_id": 1227,
            "scenario_id": "no_incoming_v1"
          },
          "use_output": "unpicked 120, holdings 20, no incoming lines"
        }
      ]
    }
  ]
}