      "type": "string"
    },
    "date_basis": {
      "default": "order_date",
      "enum": [
        "order_date",
        "expected_delivery_date",
        "picking_completed_time",
        "purchase_order_date",
        "invoice_date",
        "confirmed_delivery_time",
        "none"
      ],
      "title": "Date Basis",
      "type": "string"
    },
    "start": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Start"
    },
    "end": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End"
    },
    "filters": {
      "$ref": "#/$defs/Filters"
    },
    "limit": {
      "default": 50,
      "maximum": 200,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "maximum": 1000000,
      "minimum": 0,
      "title": "Offset",
      "type": "integer"
    }
